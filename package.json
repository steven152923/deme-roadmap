{
  "name": "deme-roadmap",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "author": "Deme App LTD",
  "description": "Deme Ops is the private local-first operating workspace for product delivery, QA, signals, systems and future Deme operations.",
  "main": "electron/main.cjs",
  "scripts": {
    "prepare:qa": "node scripts/generate-qa-catalog.mjs",
    "predev": "npm run prepare:qa",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "pretypecheck": "npm run prepare:qa",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:portable": "npm run build && electron-builder --win portable --publish never"
  },
  "dependencies": {
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.demeapp.roadmap",
    "productName": "Deme Ops",
    "artifactName": "Deme-Ops-Setup-${version}.${ext}",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.svg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Deme Ops"
    }
  }
}
